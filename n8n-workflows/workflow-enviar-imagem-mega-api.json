        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messageData\": {\n    \"to\": \"{{ $json.phoneNumber }}\",\n    \"mediaBase64\": \"{{ $json.base64Data }}\",\n    \"fileName\": \"{{ $json.imageData.fileName || 'image.jpg' }}\",\n    \"type\": \"image\",\n    \"caption\": \"{{ $json.caption || '' }}\",\n    \"mimeType\": \"{{ $json.imageData.mimeType || 'image/jpeg' }}\"\n  }\n}",
        "options": {
