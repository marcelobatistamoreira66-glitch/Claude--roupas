              "value": "Bearer M37aHjihk11"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messageData\": {\n    \"to\": \"{{ $json.phoneNumber }}\",\n    \"url\": \"{{ $json.imageUrl }}\",\n    \"fileName\": \"{{ $json.imageData.fileName || 'image.jpg' }}\",\n    \"type\": \"image\",\n    \"caption\": \"{{ $json.caption || '' }}\",\n    \"mimeType\": \"{{ $json.imageData.mimeType || 'image/jpeg' }}\"\n  }\n}",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": true
            }
          },
          "timeout": 30000
        }
      },
