      "name": "Download Imagem"
    },
    {
      "parameters": {
        "jsCode": "const binaryData = items[0].binary.data;\nconst base64Data = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst base64String = base64Data.toString('base64');\n\nconst config = $('Configuracao').item.json;\n\nreturn [{\n  json: {\n    base64: base64String,\n    mimeType: binaryData.mimeType || 'image/jpeg',\n    fileName: binaryData.fileName || 'imagem.jpg',\n    destino: config.destino,\n    legenda: config.legenda || ''\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        680
      ],
      "id": "to-base64",
      "name": "Para Base64"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://apistart02.megaapi.com.br/rest/sendMessage/megastart-M37aHjihk11/media",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
