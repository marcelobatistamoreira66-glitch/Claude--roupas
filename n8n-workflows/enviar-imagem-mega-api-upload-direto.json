    },
    {
      "parameters": {
        "jsCode": "// Pegar os dados binários da imagem\nconst binaryData = items[0].binary.data;\n\n// Converter para base64\nconst base64Data = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst base64String = base64Data.toString('base64');\n\n// Pegar informações da imagem\nconst mimeType = binaryData.mimeType || 'image/jpeg';\nconst fileName = binaryData.fileName || 'imagem.jpg';\n\n// Retornar os dados processados\nreturn [\n  {\n    json: {\n      base64: base64String,\n      mimeType: mimeType,\n      fileName: fileName,\n      destino: items[0].json.destino,\n      legenda: items[0].json.legenda || ''\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        400
      ],
      "id": "convert-base64",
      "name": "Converter Base64"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://apistart02.megaapi.com.br/rest/sendMessage/megastart-M37aHjihk11/media",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer M37aHjihk11"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messageData\": {\n    \"to\": \"{{ $json.destino }}\",\n    \"mediaBase64\": \"{{ $json.base64 }}\",\n    \"fileName\": \"{{ $json.fileName }}\",\n    \"type\": \"image\",\n    \"caption\": \"{{ $json.legenda }}\",\n    \"mimeType\": \"{{ $json.mimeType }}\"\n  }\n}",
        "options": {
          "timeout": 120000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1120,
